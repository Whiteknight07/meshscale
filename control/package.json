{
  "name": "@meshscale/control",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "npm run build && bun --bun alchemy deploy --stage dev --yes",
    "destroy": "bun --bun alchemy destroy --stage dev --yes",
    "plan": "bun --bun alchemy plan --stage dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm test",
    "build": "bun --no-env-file build src/browser.ts --target browser --minify --outfile public/console.js",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/*.ts' 'scripts/*.md' '*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'scripts/*.ts' 'scripts/*.md' '*.{ts,js,json}'"
  },
  "dependencies": {
    "effect": "4.0.6",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@cloudflare/workers-types": "5.20261026.1",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@types/node": "26.6.5",
    "alchemy": "2.0.0-beta.84",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
